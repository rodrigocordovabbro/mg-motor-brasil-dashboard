# Copie para .env e preencha apenas no ambiente autorizado. Nunca versionar .env.
# ATENÇÃO: no projeto Manus atual, desenvolvimento e publicação compartilham
# o banco gerenciado. Escritas, DDL e imports nessa base são operações reais.
# Instalações locais, laboratórios e testes experimentais exigem banco separado;
# nunca apontar esses ambientes para a DSN do banco compartilhado/produção.
NODE_ENV=development
PORT=3000

# URI MySQL privada do ambiente autorizado; para instalação/teste, use base isolada.
DATABASE_URL=

# Identificador de ambiente/aplicação usado para vincular a sessão.
MANUS_PROJECT_ID=

# Chave privada de assinatura HS256: gere um valor criptograficamente aleatório.
# Não usar uma senha de usuário, uma chave pública ou um valor previsível.
MANUS_JWT_SECRET=

# Serviços opcionais da plataforma não são necessários para o login customizado.
# Recursos gerenciados exigem provisionamento e configuração próprios.

# Sincronização server-side de Leads: JSON de conta de serviço Google própria.
# Use o cartão seguro no Manus; habilite Sheets API e compartilhe a base como
# Leitor com client_email. Não reutilizar tokens do conector da sessão.
# Nunca incluir o JSON real neste arquivo ou no Git.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# Opcional: se vazio, o servidor usa o spreadsheetId cadastrado em v2_sources.
GOOGLE_SHEETS_SPREADSHEET_ID=
